# Database
# Local dev: postgres://postgres:postgres@localhost:5432/socionics
# Railway:   provided automatically as ${{ Postgres.DATABASE_URL }}
DATABASE_URL=

# Auth.js v5
# Generate with: npx auth secret
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Google OAuth (Cloud Console -> Credentials -> OAuth 2.0 Client ID)
# Authorized redirect URI: ${AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Public app URL used by tRPC client in browser (usually equal to AUTH_URL)
NEXT_PUBLIC_APP_URL=http://localhost:3000
